//@version=5
// ============================================================================
// EJEMPLO: Backtest en BTCUSDT (4H) — Cruce SMA 20/50 con SL/TP
// Pegar en TradingView, abrir BINANCE:BTCUSDT en 4H y añadir al gráfico.
// ============================================================================
strategy("Ejemplo Backtest BTC 4H",
     overlay           = true,
     initial_capital   = 10000,
     default_qty_type  = strategy.percent_of_equity,
     default_qty_value = 100,
     commission_type   = strategy.commission.percent,
     commission_value  = 0.1,
     process_orders_on_close = true)

// --- Inputs ---
sma_rapida = input.int(20, "SMA Rápida")
sma_lenta  = input.int(50, "SMA Lenta")
sl_pct     = input.float(2.0, "Stop Loss %") / 100
tp_pct     = input.float(4.0, "Take Profit %") / 100

// --- Indicadores ---
sma_f = ta.sma(close, sma_rapida)
sma_s = ta.sma(close, sma_lenta)

// --- Señales ---
longCond  = ta.crossover(sma_f, sma_s)
shortCond = ta.crossunder(sma_f, sma_s)

// --- Órdenes (solo vela confirmada) ---
if longCond and barstate.isconfirmed
    strategy.entry("Long", strategy.long)
    strategy.exit("Exit Long", from_entry = "Long",
         stop  = close * (1 - sl_pct),
         limit = close * (1 + tp_pct))

if shortCond and barstate.isconfirmed
    strategy.entry("Short", strategy.short)
    strategy.exit("Exit Short", from_entry = "Short",
         stop  = close * (1 + sl_pct),
         limit = close * (1 - tp_pct))

// --- Visual ---
plot(sma_f, "SMA Rápida", color.blue)
plot(sma_s, "SMA Lenta",  color.red)
plotshape(longCond,  "Long",  shape.triangleup,   location.belowbar, color.green, size = size.small)
plotshape(shortCond, "Short", shape.triangledown, location.abovebar, color.red,   size = size.small)